#!/bin/sh

set -eu

if [ "$#" -ne 1 ]; then
    printf '%s\n' "Usage: commit-msg <commit-message-file>" >&2
    exit 1
fi

commit_message_file=$1
subject=$(sed -n '1p' "$commit_message_file")
current_branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || printf '%s' "detached HEAD")
repository_root=$(git rev-parse --show-toplevel)

if [ "$current_branch" = "main" ]; then
    mode=main
else
    mode=branch
fi

exec "$repository_root/scripts/validate-commit-message.sh" \
    "$mode" \
    "$subject" \
    "branch '$current_branch'"
